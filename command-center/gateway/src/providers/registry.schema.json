{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "forge-systeem/providers/registry.schema.json",
  "title": "Forge Systeem provider registry",
  "description": "One entry per provider. Validated at startup by registry.mjs (schema-validate.mjs implements the keyword subset used here, plus semantic checks the schema cannot express). Never put a key, token or secret in this file: keys are read at call time through a KeyProvider by the name in keyEnvName.",
  "type": "object",
  "required": ["schema", "catalogue", "providers"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": 1 },
    "catalogue": { "type": "string", "minLength": 1 },
    "providers": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/provider" } }
  },
  "definitions": {
    "envName": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
    "templateVar": {
      "type": "object",
      "required": ["pattern", "description"],
      "additionalProperties": false,
      "properties": {
        "pattern": { "type": "string", "minLength": 2 },
        "default": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    },
    "quirks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dropParams": { "type": "array", "items": { "type": "string", "pattern": "^[a-z_]+$" } },
        "forceN1": { "type": "boolean" },
        "dropMessageName": { "type": "boolean" },
        "temperatureFloor": { "type": "number", "minimum": 0, "maximum": 1 },
        "renameParams": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[a-z_]+$" } },
        "streamUsageOption": { "type": "boolean" },
        "noToolsWhileStreaming": { "type": "boolean" },
        "maxTokensParam": { "enum": ["max_tokens", "max_completion_tokens"] },
        "storeFalse": { "type": "boolean" }
      }
    },
    "provider": {
      "type": "object",
      "required": [
        "id", "label", "adapter", "apiStyle", "baseURL", "authType", "keyEnvName", "extraHeaders",
        "modelsMode", "modelsEndpoint", "streaming", "toolCalling", "local", "subscription",
        "noticeRequired", "tosNote", "docsURL", "verifiedOn", "verification"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,40}$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 60 },
        "adapter": { "enum": ["openai-compatible", "anthropic", "gemini-native", "ollama", "cli-claude", "cli-codex", "cli-generic"] },
        "apiStyle": { "enum": ["chat-completions", "responses", null] },
        "baseURL": { "type": ["string", "null"], "pattern": "^https?://[^\\s@?#]+$" },
        "templateVars": { "type": "object", "additionalProperties": { "$ref": "#/definitions/templateVar" } },
        "authType": { "enum": ["none", "bearer", "bearer-optional", "bearer-or-x-api-key", "api-key-header", "x-goog-api-key", "cli-managed"] },
        "keyEnvName": { "type": ["string", "null"], "pattern": "^[A-Z][A-Z0-9_]{1,63}$" },
        "optionalHeaderEnv": { "type": "object", "additionalProperties": { "$ref": "#/definitions/envName" } },
        "extraHeaders": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 200 } },
        "modelsMode": { "enum": ["endpoint", "static", "controlplane"] },
        "modelsEndpoint": { "type": ["string", "null"], "pattern": "^/[A-Za-z0-9/_.-]*$" },
        "staticModels": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "healthPath": { "type": "string", "pattern": "^/[A-Za-z0-9/_.-]*$" },
        "testCall": { "enum": ["models", "chat-1-token", "cli-version"] },
        "streaming": { "enum": [true, false, "unverified"] },
        "toolCalling": { "enum": [true, false, "internal", "unverified"] },
        "local": { "type": "boolean" },
        "subscription": { "type": "boolean" },
        "noticeRequired": { "type": "boolean" },
        "tosNote": { "type": ["string", "null"], "maxLength": 400 },
        "caveat": { "type": ["string", "null"], "maxLength": 400 },
        "notes": { "type": "string", "maxLength": 600 },
        "quirks": { "$ref": "#/definitions/quirks" },
        "command": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,30}$" },
        "cliArgs": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z0-9=_./-]+$" } },
        "forbiddenArgs": { "type": "array", "items": { "type": "string", "pattern": "^--?[a-z][a-z0-9-]*$" } },
        "docsURL": { "type": "string", "pattern": "^https://[^\\s]+$" },
        "verifiedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "verification": { "enum": ["verified", "partial", "unverified"] }
      }
    }
  }
}
