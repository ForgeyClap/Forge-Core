    },
    {
      "id": "stays-stricter",
      "type": "contains",
      "path": ".claude/skills/forge-payments/SKILL.md",
      "needle": "stay stricter where they differ",
      "why": "payment rules keep priority over the shared section"
    },
    {
      "id": "no-live-charge",
      "type": "contains",
      "path": ".claude/skills/forge-payments/SKILL.md",
      "needle": "no live charge and no live-key touch without explicit owner approval",
      "why": "owner gate stays"
    },
    {
      "id": "provenance",
      "type": "contains",
      "path": ".claude/skills/forge-payments/SKILL.md",
      "needle": "## Provenance",
      "why": "provenance block present"
